# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Client ID (phải trùng với GOOGLE_CLIENT_ID bên backend)
# Lấy từ Google Cloud Console → OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000 , http://127.0.0.1:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: for future auth features
# NEXT_PUBLIC_AUTH_SECRET=your-secret-here