# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/defense_db

# AI API Keys (chọn 1 trong 2)
NVIDIA_API_KEY=your-nvidia-key-here
LOCAL_API_KEY=sk-f3ac88abb90d894b-o4159v-470a9d6a
LOCAL_BASE_URL=http://host.docker.internal:20128/v1
LOCAL_MODEL=google

# Security
SECRET_KEY=your-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth Client ID (BẮT BUỘC cho Đăng nhập bằng Google)
# Lấy từ Google Cloud Console → OAuth client ID (Web application type)
# Authorized JavaScript origins: http://localhost:3000 , http://127.0.0.1:3000
GOOGLE_CLIENT_ID=

# MinIO / S3 (local dev)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=defend-files
MINIO_REGION=us-east-1
MINIO_SECURE=false

# Optional: for production
# DEBUG=False
# ALLOWED_HOSTS=localhost,api.example.com